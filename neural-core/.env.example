# Neural Core server. Copy to .env and adjust.

# Online leaderboard database (free Neon PostgreSQL, see README "Online leaderboard database").
# Paste the connection string from console.neon.tech -> your project -> Connect.
# Leave empty to run offline; the local ledger (data/ledger.jsonl) still keeps every run.
DATABASE_URL=

# Port for the site, REST API and WebSocket (single origin)
PORT=3001
HOST=0.0.0.0

# Volunteer PIN for /operator
OPERATOR_PIN=2468

# Kiosk stations and where each one's sensor is:
#   serial:<port>  Arduino plugged into this machine (COM3, /dev/ttyACM0, /dev/cu.usbmodem1101)
#   bridge         Arduino on the kiosk laptop, forwarded by `pnpm bridge` or the browser bridge
#   fake           synthetic EEG (demo, rehearsal, sensor-failure fallback)
#   replay:<file>  loop a recorded session from data/recordings
#   none           pick later in the operator console
STATIONS=1=fake
# STATIONS=1=serial:COM3,2=bridge,3=bridge

SERIAL_BAUD=115200
# Board sample rate if known: 500 for the Chords firmware on the UNO R4. 0 = detect automatically.
SERIAL_RATE=0
# Mains notch frequency: 50 (India/EU) or 60 (Americas)
MAINS_HZ=50

# Same seed for every player = same zombie wave = fair leaderboard
EVENT_SEED=20261031
# Ranked shifts per player; later shifts are saved as "encore"
ATTEMPTS_PER_PLAYER=3
EVENT_NAME=Neural Core Arena

# Where the ledger and raw recordings are written (default: ./data)
# DATA_DIR=./data

# Dev only: the Next dev server on :3000 finds the API on :3001 by itself.
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
