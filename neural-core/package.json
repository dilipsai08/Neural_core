{
  "name": "neural-core",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @neural-core/shared build && pnpm --parallel --filter @neural-core/shared --filter @neural-core/api --filter @neural-core/web dev",
    "dev:api": "pnpm --filter @neural-core/api dev",
    "dev:web": "pnpm --filter @neural-core/web dev",
    "build": "pnpm --filter @neural-core/shared build && pnpm --filter @neural-core/web build && pnpm --filter @neural-core/api build",
    "start": "node apps/api/dist/index.js",
    "bridge": "pnpm --filter @neural-core/api bridge",
    "typecheck": "pnpm --filter @neural-core/shared build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @neural-core/shared build && pnpm -r test",
    "sensor:check": "pnpm --filter @neural-core/api sensor:check"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
