{
  "name": "neural-core",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @neural-core/* dev",
    "dev:api": "pnpm --filter @neural-core/api dev",
    "dev:web": "pnpm --filter @neural-core/web dev",
    "build": "pnpm -r build",
